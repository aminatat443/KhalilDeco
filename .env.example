APP_NAME="Khalil Déco"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Renseignez cette clé (disponible sur cloudinary.com/console) pour que les images produit et
# la facture basculent automatiquement sur Cloudinary — sinon le stockage local est utilisé.
CLOUDINARY_URL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Paiement en ligne Wave/Orange Money/Carte bancaire via PayTech (paytech.sn/dashboard).
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test

# Optionnel — ne renseigner que si APP_URL n'est pas joignable en HTTPS (PayTech l'exige pour
# ipn_url). Laisser vide en production si APP_URL est déjà en https:// : les URL sont alors
# générées automatiquement par route().
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=
PAYTECH_IPN_URL=
# Compensation temporaire des frais ajoutés côté client par PayTech (voir commentaire dans
# config/services.php) — 0.02 = 2%. À désactiver (0) dès que réglé depuis leur tableau de bord.
PAYTECH_FEE_RATE=0

# Wave Business (docs.wave.com) — clé API + secret de webhook depuis business.wave.com/dev-portal.
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SUCCESS_URL=
WAVE_ERROR_URL=

# Orange Money Web Payment (developer.orange.com/apis/om-webpay) — identifiants + clé marchand
# fournis par Orange à l'activation du compte. ORANGE_MONEY_COUNTRY est le code pays donné par
# Orange (ex. "sn"), jamais à deviner.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COUNTRY=sn
ORANGE_MONEY_SUCCESS_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_NOTIF_URL=

# PayDunya (developers.paydunya.com) — Wave, Orange Money, Carte, Djamo, Free Money.
# PAYDUNYA_MODE choisit le jeu de clés utilisé (test ou live) — les deux jeux peuvent rester
# renseignés en même temps, jamais interchangeables entre eux (tableau de bord PayDunya →
# Paramètres → API Keys, un jeu par mode).
PAYDUNYA_MODE=test
PAYDUNYA_TEST_MASTER_KEY=
PAYDUNYA_TEST_PRIVATE_KEY=
PAYDUNYA_TEST_PUBLIC_KEY=
PAYDUNYA_TEST_TOKEN=
PAYDUNYA_LIVE_MASTER_KEY=
PAYDUNYA_LIVE_PRIVATE_KEY=
PAYDUNYA_LIVE_PUBLIC_KEY=
PAYDUNYA_LIVE_TOKEN=
PAYDUNYA_SUCCESS_URL=
PAYDUNYA_CANCEL_URL=
PAYDUNYA_CALLBACK_URL=

VITE_APP_NAME="${APP_NAME}"
